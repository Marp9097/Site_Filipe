# Copie para .env e preencha. O .env NUNCA vai para o git.

# Gere uma chave nova:
#   .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-gerada

# Só vale com config.settings.dev (manage.py). Em produção o DEBUG é sempre False.
DEBUG=True

# Host do site público e host do painel (sem porta).
# Dev: localhost e painel.localhost | Produção: www.comunicacaocreative.com.br e painel.comunicacaocreative.com.br
SITE_HOST=localhost
PAINEL_HOST=painel.localhost
ALLOWED_HOSTS=localhost,painel.localhost,127.0.0.1

# Vazio em dev (usa db.sqlite3). Produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Só produção (config.settings.prod):
# CSRF_TRUSTED_ORIGINS=https://www.comunicacaocreative.com.br,https://painel.comunicacaocreative.com.br
